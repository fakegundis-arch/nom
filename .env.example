# Copy this file to .env ON THE VPS and fill it in there.
# Never commit .env, never paste these values into chats or screenshots.

# --- Bybit (API Management: FiatP2P permission, IP-locked to the VPS, NO withdrawals) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com

# --- Nomba (dashboard: Settings -> Webhook & API Keys) ---
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
# Webhook signing key, from the same dashboard page
NOMBA_WEBHOOK_SECRET=
# Start with the sandbox. Switch to https://api.nomba.com only after testing
# AND Nomba's written OK for crypto P2P.
NOMBA_BASE_URL=https://sandbox.nomba.com

# --- Telegram (create a bot with @BotFather; get your chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Behaviour ---
POLL_SECONDS=5
PAYMENT_WINDOW_MINUTES=30
NAIRA_LOW_THRESHOLD=500000
USDT_LOW_THRESHOLD=300
DB_PATH=data/p2pbot.sqlite3
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

# Phase 1 safety switch: the bot only watches and alerts, it never moves money.
MONITOR_ONLY=true
